# Copy to .env.local and fill in.

# API steps (generate-response)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local hardware steps (retrieve-context, postprocess) — defaults to Ollama's local port
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# Remote hardware steps (rerank-candidates) — rented GPU box exposing an OpenAI-compatible API
REMOTE_MODEL_BASE_URL=http://localhost:11434/v1
REMOTE_MODEL_API_KEY=

# Ecosystem builder's challenge-analysis model — defaults to a local Ollama model
# (no API key required). Registry key format: "provider > model", e.g. "openai > gpt-5.4".
ECOSYSTEM_ANALYZE_MODEL=local > llama3.2:latest
